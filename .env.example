# ─── AI Coach ────────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# ─── Firebase Push Notifications (FCM V1) ────────────────────────────────────
# Service account JSON base64-encoded — used by /api/push-notify (FCM V1 API)
# Get from: Firebase Console → Project Settings → Service accounts → Generate new private key
# Then run: base64 -i serviceAccountKey.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoic2Vydm...

# VAPID public key — used in browser to register for push notifications
# Get from: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Key pair
NEXT_PUBLIC_FCM_VAPID_KEY=BN...

# ─── Admin Access ─────────────────────────────────────────────────────────────
# REQUIRED — comma-separated Firebase UIDs for /admin/* route protection.
# Used by proxy.js (route guard) and /api/admin/session (cookie issuance).
# Get UID from: Firebase Console → Authentication → Users → Copy UID
ADMIN_UIDS=uid1,uid2
ADMIN_SESSION_SECRET=generate-a-long-random-string-32chars-plus

# Optional — exposes admin UIDs to the browser for client-side UI checks.
# Do NOT rely on this for authorization; ADMIN_UIDS is the authoritative list.
NEXT_PUBLIC_ADMIN_UIDS=uid1,uid2

# ─── Stripe Subscriptions (Test Mode) ────────────────────────────────────────
# Use TEST keys until app is stable. Switch to sk_live_ / pk_live_ for production.
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook secret — Stripe Dashboard → Webhooks → your endpoint → Signing secret
# For local dev use Stripe CLI: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — create recurring prices in Stripe Dashboard (Test mode) → Products
# GAVANA Pro prices in MNT — must match lib/pro.js (9,900₮ / month, 79,000₮ / year).
# Pro is only offered when the secret key, webhook secret, a price and
# FIREBASE_SERVICE_ACCOUNT_BASE64 are all set (lib/server/stripeConfig.js).
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
