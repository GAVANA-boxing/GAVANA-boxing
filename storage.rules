rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Helpers ─────────────────────────────────────────────────────────────
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Uploads must declare an image/video type and stay under a size cap, so
    // nobody can park arbitrary files (or multi-GB blobs) in the bucket.
    function isImage(maxMB) {
      return request.resource.contentType.matches('image/.*')
          && request.resource.size < maxMB * 1024 * 1024;
    }
    function isVideo(maxMB) {
      return request.resource.contentType.matches('video/.*')
          && request.resource.size < maxMB * 1024 * 1024;
    }

    // ─── Stories ─────────────────────────────────────────────────────────────
    // Authenticated users may read any story media (needed for StoryViewer).
    match /stories/{uid}/{file} {
      allow read:   if request.auth != null;
      allow write:  if isOwner(uid) && (isImage(10) || isVideo(100));
      allow delete: if isOwner(uid);
    }

    // ─── Reels ───────────────────────────────────────────────────────────────
    // Public read (reel thumbnails/videos are publicly accessible).
    match /reels/{uid}/{file} {
      allow read:   if true;
      allow write:  if isOwner(uid) && (isVideo(200) || isImage(10));
      allow delete: if isOwner(uid);
    }
    // lib/uploadVideo.js: reels/videos/{uid}/… and reels/thumbnails/{uid}/…
    match /reels/videos/{uid}/{file} {
      allow read:   if true;
      allow write:  if isOwner(uid) && isVideo(200);
      allow delete: if isOwner(uid);
    }
    match /reels/thumbnails/{uid}/{file} {
      allow read:   if true;
      allow write:  if isOwner(uid) && isImage(5);
      allow delete: if isOwner(uid);
    }

    // ─── Profile images ───────────────────────────────────────────────────────
    match /profile-images/{uid}/{file} {
      allow read:   if true;
      allow write:  if isOwner(uid) && isImage(10);
      allow delete: if isOwner(uid);
    }

    // ─── Gym logos ────────────────────────────────────────────────────────────
    match /gyms/{uid}/{file} {
      allow read:   if true;
      allow write:  if isOwner(uid) && isImage(10);
      allow delete: if isOwner(uid);
    }

    // ─── Coach application photos ─────────────────────────────────────────────
    // Private: only the applicant (admins review via the Admin SDK, which
    // bypasses these rules). Previously any signed-in user could read them.
    match /coach_applications/{uid}/{file} {
      allow read:   if isOwner(uid);
      allow write:  if isOwner(uid) && isImage(10);
      allow delete: if isOwner(uid);
    }

  }
}
